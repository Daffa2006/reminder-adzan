{
    "name": "reminder-adzan",
    "version": "0.0.0",
    "private": true,
    "description": "Aplikasi jadwal salat modern berbasis web, dibangun dengan Vue 3, Tailwind CSS, Supabase, dan AlAdhan API.",
    "homepage": "https://github.com/Daffa2006/reminder-adzan#readme",
    "bugs": {
